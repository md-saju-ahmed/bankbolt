# Copy to apps/api/.env.local for local development.
# Pooled connection URL for a dedicated Neon development database.
DATABASE_URL=
# Direct connection URL for reviewed migrations to that same development database.
DATABASE_MIGRATION_URL=
# Generate a random secret of at least 32 bytes and keep it private.
SESSION_SECRET=
# Origin of the frontend, without a trailing slash. Use HTTPS on Vercel.
WEB_ORIGIN=http://localhost:3000
# Optional password for the explicit demo seed command.
DEMO_PASSWORD=
# PORT=4000
