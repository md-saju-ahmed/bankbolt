{
  "name": "@bankbolt/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:ping": "node --env-file-if-exists=.env.local src/db/ping.ts",
    "db:seed:demo": "node --env-file-if-exists=.env.local src/db/seed.ts",
    "db:seed:portfolio": "node --env-file=.env.demo.local src/db/seed.ts --portfolio",
    "test": "vitest run --project unit --project api",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "vitest": "5.1.1"
  }
}
