# Next.js reads apps/web/.env.local. Set this on Vercel to the HTTPS API origin.
# API_ORIGIN=http://localhost:4000
# Set to true to opt in on the isolated demo deployment (before building).
# Local next dev can show quick-fill with just the password. Set false to disable.
# DEMO_LOGIN_ENABLED=
# Public password for the three fictional accounts. Use the seed's DEMO_PASSWORD.
NEXT_PUBLIC_DEMO_PASSWORD=
